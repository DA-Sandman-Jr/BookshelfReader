<Project>
  <PropertyGroup>
    <!-- Opt in to synchronized B44 organization guidance. The packable library
         is the stable once-per-build synchronization anchor. -->
    <B44AgentSyncEnabled>true</B44AgentSyncEnabled>
    <B44AgentGuidanceProfile>Organization</B44AgentGuidanceProfile>
    <B44AgentRepositoryRoot>$(MSBuildThisFileDirectory)</B44AgentRepositoryRoot>
    <B44AgentSyncProject>$(MSBuildThisFileDirectory)BookshelfReader\BookshelfReader.csproj</B44AgentSyncProject>

    <!-- Repository hygiene and the analyzer-suppression ratchet. This
         repository does not run the source-size ratchet, so they carry their
         own anchor: the same project the guidance sync uses. -->
    <B44HygieneEnabled>true</B44HygieneEnabled>
    <B44HygieneProject>$(B44AgentSyncProject)</B44HygieneProject>
    <B44HygieneRepositoryRoot>$(MSBuildThisFileDirectory)</B44HygieneRepositoryRoot>
    <B44SuppressionBudget>0</B44SuppressionBudget>
    <B44WarningPolicy>true</B44WarningPolicy>

    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <B44SecuritySensitive Condition="'$(MSBuildProjectName)' == 'BookshelfReader'">true</B44SecuritySensitive>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Surface editorconfig style/naming violations at build time so CI and
         local `dotnet build` catch drift instead of waiting for `dotnet format`. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required to make IDE0005 (remove unnecessary usings) fire at build
         time. See https://github.com/dotnet/roslyn/issues/41640. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress "missing XML comment". We generate doc files only to enable
         IDE0005, not to document every public member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Shared NuGet package metadata. Applied to every project but only used by
       the packable ones (Core, Infrastructure, Extensions, Api). The version is
       a local-pack default; the release workflow overrides it from the git tag
       (-p:Version). -->
  <PropertyGroup>
    <Version>3.2.0</Version>
    <Authors>David Sanders</Authors>
    <Company>David Sanders</Company>
    <Copyright>Copyright © David Sanders</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DA-Sandman-Jr/BookshelfReader</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DA-Sandman-Jr/BookshelfReader.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>bookshelf;book;claude;vision;anthropic;openai;gemini;opencv;openlibrary;aspnetcore;pipeline</PackageTags>
  </PropertyGroup>

  <!-- Studio-wide code-quality analyzer rollout. -->
  <ItemGroup>
    <PackageReference Include="B44.Standards" Version="0.12.*" PrivateAssets="all" />
  </ItemGroup>
</Project>
